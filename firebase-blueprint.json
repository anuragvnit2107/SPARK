{
  "entities": {
    "Board": {
      "title": "Board",
      "description": "A SPARK collaborative whiteboard & engineering workspace persisted in Firestore.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the board owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Display title of the canvas board.",
          "minLength": 1,
          "maxLength": 140
        },
        "category": {
          "type": "string",
          "description": "Spatial hub category classification.",
          "enum": ["Architecture", "Circuits", "Math", "Wireframes"]
        },
        "tags": {
          "type": "array",
          "description": "Bounded list of searchable tags (max 12)."
        },
        "elements": {
          "type": "array",
          "description": "Canvas WhiteboardElement objects (max 1000)."
        },
        "collaborators": {
          "type": "array",
          "description": "Bounded list of collaborator Firebase Auth UIDs (max 25)."
        },
        "shareEnabled": {
          "type": "boolean",
          "description": "Whether signed-in users with the Room ID or invite link can join."
        },
        "camera": {
          "type": "object",
          "description": "Saved viewport camera offset and zoom state."
        },
        "canvasThemeId": {
          "type": "string",
          "description": "Identifier for the active canvas color theme.",
          "minLength": 1,
          "maxLength": 48
        },
        "spatialPosition": {
          "type": "object",
          "description": "3D Spatial Hub coordinates and pinned flag."
        },
        "elementCount": {
          "type": "integer",
          "description": "Count of active non-deleted elements on the board."
        },
        "lastNoteSnippet": {
          "type": "string",
          "description": "Short preview snippet from the most recent note or circuit.",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": [
        "ownerId",
        "title",
        "category",
        "tags",
        "elements",
        "collaborators",
        "shareEnabled",
        "camera",
        "canvasThemeId",
        "elementCount",
        "lastNoteSnippet",
        "createdAt",
        "updatedAt"
      ]
    },
    "BoardPresence": {
      "title": "BoardPresence",
      "description": "Live collaborator cursor position and active tool on a shared board.",
      "type": "object",
      "properties": {
        "peerId": {
          "type": "string",
          "description": "Collaborator Firebase Auth UID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Collaborator display name.",
          "minLength": 1,
          "maxLength": 80
        },
        "color": {
          "type": "string",
          "description": "Hex color for cursor badge.",
          "minLength": 4,
          "maxLength": 20
        },
        "x": {
          "type": "number",
          "description": "World X cursor coordinate."
        },
        "y": {
          "type": "number",
          "description": "World Y cursor coordinate."
        },
        "tool": {
          "type": "string",
          "description": "Currently selected canvas tool.",
          "minLength": 1,
          "maxLength": 32
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server heartbeat timestamp."
        }
      },
      "required": ["peerId", "name", "color", "x", "y", "tool", "updatedAt"]
    }
  },
  "firestore": {
    "/boards/{boardId}": {
      "schema": { "$ref": "#/entities/Board" },
      "description": "User-owned and collaborator-shared whiteboard documents."
    },
    "/boards/{boardId}/presence/{userId}": {
      "schema": { "$ref": "#/entities/BoardPresence" },
      "description": "Ephemeral live collaborator cursor positions per board."
    }
  }
}
